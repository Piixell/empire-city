# ---------------------------------------------------------------------------
# Empire City — variabili d'ambiente
# Copia questo file in `.env.local` (sviluppo) e configura le stesse variabili
# nel progetto Vercel (Settings → Environment Variables).
#
# Se NEXT_PUBLIC_SUPABASE_URL e DATABASE_URL sono assenti e NODE_ENV non è
# "production", l'app parte in MODALITÀ LOCALE: database PGlite su disco in
# ./.data, identità di sviluppo per scheda del browser e sincronizzazione via
# polling. Utile per provare il gioco senza Supabase; non usarla in produzione.
# ---------------------------------------------------------------------------

# URL del progetto Supabase (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chiave pubblica "anon"/"publishable" (Project Settings → API). È sicura lato
# browser perché tutte le tabelle sono protette da RLS e le scritture passano
# solo dalle API server.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Stringa di connessione Postgres usata SOLO dalle API server (mai esposta al
# browser). Usa il "Transaction pooler" di Supabase (porta 6543):
# Project Settings → Database → Connection string → Transaction pooler.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# NON serve la Service Role Key: l'app non la usa e non va mai messa in
# variabili NEXT_PUBLIC_*.
